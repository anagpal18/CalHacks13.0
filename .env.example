NESSIE_API_KEY=your-nessie-key-here
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_MODE=live

API_PORT=4000
# Generate each with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SEAT_TOKEN_INTAKE=
SEAT_TOKEN_VENDOR_RECORDS=
SEAT_TOKEN_MATCHING=
SEAT_TOKEN_PAYMENTS=
SEAT_TOKEN_DASHBOARD=

# ---- Creao seat gateway (services/gateway, port 8787) ----
# Generate the two keys with the command above. The dashboard key is added by the Vite dev proxy.
BP_ADMIN_KEY=
BP_DASHBOARD_KEY=
# Public tunnel URL the Creao agents use (corepack pnpm tunnel prints it)
BP_GATEWAY_URL=
# Needed to actually run agents on uploaded bills
ANTHROPIC_API_KEY=
CREAO_API_KEY=
CREAO_AGENT_INTAKE=
CREAO_AGENT_VENDOR_RECORDS=
CREAO_AGENT_MATCHING=
# CRS sandbox login (Verify page and the Vendor-Records seat)
CRS_USERNAME=
CRS_PASSWORD=
